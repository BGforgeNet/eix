# Build and test image: the pinned Rust toolchain (rust-toolchain.toml), the mingw-w64 linker for
# i686-pc-windows-gnu, Wine to run the Windows test binaries, and the tools of the gate and the release package.
# Debian sid at a pinned digest, with packages from the dated snapshot in build/debian.sources, raised deliberately.
# Per-package pins do not survive sid's version replacement.

FROM docker.io/library/debian:sid-slim@sha256:10e9e0d7aa4ed47205c7053f117199e6b06a9b17ac3eeb7f7bb1a818b963a803
COPY build/debian.sources /etc/apt/sources.list.d/debian.sources
# hadolint ignore=DL3008
RUN dpkg --add-architecture i386 \
    && apt-get update -qq \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends \
        rustup gcc gcc-multilib libc6-dev gcc-mingw-w64-i686 g++-mingw-w64-i686 make git ca-certificates wine wine32:i386 \
        zip curl \
    && rm -rf /var/lib/apt/lists/*
ENV WINEDEBUG=-all
# Installs the toolchain the file names; a later change to it reinstalls on the next image build.
COPY rust-toolchain.toml /toolchain/
RUN cd /toolchain && rustup show
# The gate's dependency and workflow checks and the package's licence notices, from their releases' prebuilt
# binaries: building them from source took most of a cold image build.
COPY build/install-tools.sh /tmp/install-tools.sh
RUN /tmp/install-tools.sh && rm /tmp/install-tools.sh
# The documentation site's builder, from its release, checked against the release's published checksum. The Pages
# workflow runs the same script, so the version is pinned there once.
COPY build/install-mdbook.sh /tmp/install-mdbook.sh
RUN /tmp/install-mdbook.sh && rm /tmp/install-mdbook.sh
# The session's runtime folder, which Wine's Wayland driver looks up whenever a window-system DLL loads; unset, the
# lookup prints an error into the test output. No compositor runs, so the driver finds none there and goes on.
ENV XDG_RUNTIME_DIR=/root/.xdg-runtime
RUN mkdir -m 0700 "$XDG_RUNTIME_DIR"
# Creates the Wine prefix once, not on every test run.
RUN wineboot --init && /usr/lib/i386-linux-gnu/wine/wineserver --wait
# Runs as the image's root on purpose: under rootless podman that is the invoking user, so the build can write the
# mounted source tree's target directory; a non-root USER would map to a subordinate uid that cannot.
